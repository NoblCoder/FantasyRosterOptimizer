DATABASE_URL="postgresql://roster_iq:change-me@localhost:5432/roster_iq?schema=public"
PORT=3000
NODE_ENV=development
# Comma-separated browser origins. Use the deployed app origin in production.
CORS_ORIGINS=http://localhost:8081
# Required to invoke POST /api/admin/refresh.
REFRESH_API_KEY=replace-with-a-long-random-secret
# Private ESPN league sync. Keep these values on the backend only; never expose
# them through EXPO_PUBLIC_ variables or commit them.
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_S2=
ESPN_SWID=
ESPN_SEASON=2026
# Add an OpenWeatherMap key before enabling weather ingestion.
OPENWEATHER_API_KEY=
# AI roster advice. Keep this server-side only; never add it to app/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Production should trigger refreshes through an external scheduler.
ENABLE_INTERNAL_SCHEDULER=false
