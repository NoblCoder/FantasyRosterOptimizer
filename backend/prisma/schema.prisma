generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rosters   Roster[]
}

model Player {
  id          String         @id @default(uuid())
  espnId      String?        @unique
  name        String
  team        String?
  position    String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rosterSlots RosterPlayer[]
  projections WeeklyProjection[]
  usage       PlayerUsage[]
  history     HistoricalPerformance[]

  @@index([team, position])
}

model Roster {
  id            String         @id @default(uuid())
  userId        String
  name          String
  scoringFormat String         @default("PPR")
  flexSpots     Int            @default(1)
  benchSize     Int            @default(6)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  players       RosterPlayer[]

  @@index([userId])
}

model RosterPlayer {
  id       String @id @default(uuid())
  rosterId String
  playerId String
  status   String @default("BENCH")
  roster   Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([rosterId, playerId])
  @@index([playerId])
}

model Stadium {
  id          String            @id @default(uuid())
  espnVenueId String?           @unique
  name        String
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?
  isDome      Boolean           @default(false)
  surface     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  weather     WeatherForecast[]
  matchups    Matchup[]
}

model WeeklyProjection {
  id          String   @id @default(uuid())
  playerId    String
  season      Int
  week        Int
  source      String
  points      Float
  rawPayload  Json?
  retrievedAt DateTime @default(now())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week, source])
  @@index([season, week])
}

model PlayerUsage {
  id        String   @id @default(uuid())
  playerId  String
  season    Int
  week      Int
  snapShare Float?
  touches   Int?
  targets   Int?
  adjustment Float @default(0)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week])
  @@index([season, week])
}

model HistoricalPerformance {
  id               String @id @default(uuid())
  playerId         String
  opponent         String
  pointsPerGame    Float
  adjustment       Float  @default(0)
  player           Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, opponent])
}

model Matchup {
  id                String   @id @default(uuid())
  season            Int
  week              Int
  team              String
  opponent          String
  position          String
  stadiumId         String?
  defenseRank       Int?
  pointsAllowed     Float?
  adjustment        Float    @default(0)
  rawPayload        Json?
  retrievedAt       DateTime @default(now())
  stadium           Stadium? @relation(fields: [stadiumId], references: [id], onDelete: SetNull)

  @@unique([season, week, team, position])
  @@index([season, week, opponent])
}

model WeatherForecast {
  id            String   @id @default(uuid())
  stadiumId     String
  season        Int
  week          Int
  conditions    String?
  temperatureF  Float?
  windMph       Float?
  precipitation Float?
  adjustment    Float    @default(0)
  forecastAt    DateTime
  retrievedAt   DateTime @default(now())
  stadium       Stadium  @relation(fields: [stadiumId], references: [id], onDelete: Cascade)

  @@unique([stadiumId, season, week])
  @@index([season, week])
}

model DataRefresh {
  id          String    @id @default(uuid())
  provider    String
  resource    String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  detail      Json?

  @@index([provider, resource, startedAt])
}
